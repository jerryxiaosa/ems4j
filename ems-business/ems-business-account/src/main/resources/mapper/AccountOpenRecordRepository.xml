<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="info.zhihui.ems.business.account.repository.AccountOpenRecordRepository">

    <select id="selectLatestOpenByAccountId" resultType="info.zhihui.ems.business.account.entity.AccountOpenRecordEntity">
        select *
        from energy_account_open_record
        where is_deleted = 0
          and account_id = #{accountId}
        order by open_time desc, id desc
        limit 1
    </select>
</mapper>
